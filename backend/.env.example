# Copy to ".env" and adjust. Real environment variables always take priority over this file.

APP_NAME=HazardAtlas API

# Relative SQLite paths are resolved against the backend/ folder (not the working directory).
DATABASE_URL=sqlite:///./hazardatlas.db

# Comma-separated list of allowed browser origins (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# Relative paths are resolved against the backend/ folder.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
AUTHORITY_USERNAME= 
AUTHORITY_PASSWORD_HASH=
AUTH_TOKEN_SECRET=

CLOUDINARY_CLOUD_NAME= 
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=